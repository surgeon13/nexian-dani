{
  "name": "nexian",
  "version": "1.8.88",
  "description": "Menu-driven Playwright automation helper for Nexian",
  "main": "login.js",
  "scripts": {
    "login": "node --max-old-space-size=768 login.js",
    "login:headed": "node --max-old-space-size=768 login.js --headed --keep-open",
    "login:nexian": "node --max-old-space-size=768 login.js --nexian-env-file=.env.nexian --keep-open",
    "login:nexian:headed": "node --max-old-space-size=768 login.js --nexian-env-file=.env.nexian --headed --keep-open",
    "login:nexian:headless": "node --max-old-space-size=768 login.js --nexian-env-file=.env.nexian --keep-open",
    "dashboard": "node --max-old-space-size=768 login.js --dashboard --keep-open",
    "dashboard:nexian": "node --max-old-space-size=768 login.js --dashboard --nexian-env-file=.env.nexian --keep-open",
    "dashboard:nexian:headless": "node --max-old-space-size=768 login.js --dashboard --nexian-env-file=.env.nexian --keep-open",
    "dashboard:headed": "node --max-old-space-size=768 login.js --dashboard --headed --keep-open",
    "dashboard:nexian:headed": "node --max-old-space-size=768 login.js --dashboard --nexian-env-file=.env.nexian --headed --keep-open",
    "dashboard:dev": "node --max-old-space-size=768 login.js --dashboard --headed --keep-open",
    "dashboard:dev:nexian": "node --max-old-space-size=768 login.js --dashboard --headed --keep-open --nexian-env-file=.env.nexian",
    "dashboard:dev:nexian:headless": "node --max-old-space-size=768 login.js --dashboard --keep-open --nexian-env-file=.env.nexian",
    "start:24-7": "bash ./scripts/start-24-7.sh",
    "start:24-7:pc": "node ./scripts/start-24-7.js",
    "keep-alive": "bash ./scripts/keep-alive.sh",
    "keep-alive:pc": "node ./scripts/keep-alive.js",
    "cursor:install": "bash ./scripts/cursor-cloud-install.sh",
    "cursor:start": "bash ./scripts/cursor-cloud-start.sh",
    "cursor:ensure": "bash ./scripts/cursor-cloud-ensure.sh",
    "termux:setup": "bash ./scripts/termux-proot-setup.sh",
    "termux:run": "bash ./scripts/termux-proot-run.sh",
    "setup:pc": "npm install --no-audit --no-fund && npx playwright install chromium",
    "export": "node export.js",
    "playwright:install": "npx playwright install chromium",
    "clean:runtime": "node -e \"const fs=require('fs');['storageState.json','log.jsonl','top10.log','session-presence.json','templates/progress.json'].forEach(f=>{if(fs.existsSync(f))fs.rmSync(f,{force:true});});console.log('Removed runtime files: storageState.json, log.jsonl, top10.log, session-presence.json, templates/progress.json');\"",
    "test": "node scripts/test-session-presence.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.1",
    "playwright": "^1.59.1"
  }
}
