{
  "name": "nexian",
  "version": "1.5.4",
  "description": "Menu-driven Playwright automation helper for Nexian",
  "main": "login.js",
  "scripts": {
    "login": "node login.js",
    "login:headed": "node login.js --headed --keep-open",
    "login:nexian": "node login.js --env-file=.env.nexian --keep-open",
    "login:nexian:headed": "node login.js --env-file=.env.nexian --headed --keep-open",
    "login:nexian:headless": "node login.js --env-file=.env.nexian --keep-open",
    "dashboard": "node login.js --dashboard --keep-open",
    "dashboard:nexian": "node login.js --dashboard --env-file=.env.nexian --keep-open",
    "dashboard:nexian:headless": "node login.js --dashboard --env-file=.env.nexian --keep-open",
    "dashboard:headed": "node login.js --dashboard --headed --keep-open",
    "dashboard:nexian:headed": "node login.js --dashboard --env-file=.env.nexian --headed --keep-open",
    "dashboard:dev": "node login.js --dashboard --headed --keep-open",
    "dashboard:dev:nexian": "node login.js --dashboard --headed --keep-open --env-file=.env.nexian",
    "dashboard:dev:nexian:headless": "node login.js --dashboard --keep-open --env-file=.env.nexian",
    "export": "node export.js",
    "playwright:install": "npx playwright install chromium",
    "clean:runtime": "node -e \"const fs=require('fs');['storageState.json','log.jsonl','templates/progress.json'].forEach(f=>{if(fs.existsSync(f))fs.rmSync(f,{force:true});});console.log('Removed runtime files: storageState.json, log.jsonl, templates/progress.json');\"",
    "test": "echo \"No tests configured\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.1",
    "playwright": "^1.59.1"
  }
}
