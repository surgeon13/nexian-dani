# Nexian automation — copy to `.env` and set real credentials.
# `node setup.js` / first run may create `.env` from this file.
#
# As of v1.8.103, `.env` holds ONLY these three keys: identity (who logs in)
# and which realm to talk to. That's it — nothing else belongs here anymore.
#
# Every OTHER setting (loops, thresholds, proxy, dashboard, builder,
# trainer, celebrations, raid evacuation, logging, ...) lives in
# templates/settings.json instead, auto-created on first run from
# templates/settings.example.json. Edit it directly, or use the terminal
# menu (Settings) / web dashboard — both write to templates/settings.json
# now, never here. See README.md's "Configuration" section for the full
# list of keys and what they do.
#
# Why the split: this file used to carry ~90 settings and kept ending up
# broken, duplicated, or edited in the wrong copy on people's machines —
# a problem that's obvious in seconds with 3 lines and much harder to spot
# in 90. Keeping `.env` this small also means a broken/misplaced
# templates/settings.json can never stop you from logging in at all.

NEXIAN_USERNAME=your_username_here
NEXIAN_PASSWORD=your_password_here

# Realm host for in-game pages (farmlist, builder, trainer, status). Point this at
# your realm, e.g. https://s1.nexian.world — the nexian.world portal redirects to
# village2.php and will break farmlist/builder navigation.
# Not sure which realm you're actually on? Log in manually once in a normal
# browser and look at the address bar once you're in the game (not the
# nexian.world portal) — it'll be something like https://s1.nexian.world,
# https://s2.nexian.world, or occasionally a named realm like
# https://test.nexian.world. Whatever it says there is your GAME_HOST. A
# wrong value here (e.g. s2 when your account is actually on "test") makes
# login fail with "Login did not reach the game after Enter Realm" —
# not a bug, just the wrong realm configured.
GAME_HOST=https://s1.nexian.world

# --- Advanced (rarely needed) ---
# NEXIAN_URL overrides the portal login flow entirely -- leave this unset.
# Without it, login.js builds the direct login-modal URL for your GAME_HOST
# realm automatically (https://nexian.world/?login=1&world=<realm>, e.g.
# world=s1), skipping the portal's "Play Now" + realm-selection click-through.
# Only set this if you need something else (a non-default portal flow,
# testing, etc.) -- and be aware it permanently out-ranks GAME_HOST for
# login purposes whenever it's set at all.
# NEXIAN_URL=https://nexian.world/
