# Nexian automation — copy to `.env` and set real credentials.
# `node setup.js` / first run may create `.env` from this file.

# --- Required ---
NEXIAN_URL=https://nexian.world/
NEXIAN_USERNAME=your_username_here
NEXIAN_PASSWORD=your_password_here

# Realm host for in-game pages (farmlist, builder, trainer, status). Point this at
# your realm, e.g. https://s1.nexian.world — the nexian.world portal redirects to
# village2.php and will break farmlist/builder navigation.
GAME_HOST=https://s1.nexian.world

# --- Browser ---
HEADLESS=true
KEEP_OPEN=true
# Speed: block images/fonts/media downloads (faster page loads, less RAM). Set false to load full pages.
BLOCK_MEDIA=true

# --- Proxy (optional) ---
# Playwright routes the game browser through this proxy. Leave PROXY_SERVER empty for direct connection.
# Examples: http://127.0.0.1:8080  socks5://user:pass@host:1080  host:3128 (http assumed)
# Change at runtime: Settings [Y] or main menu [y] — logout, apply proxy, login, continue.
# Paste multiple proxies in the dashboard Settings tab or terminal proxy menu [2].
# Pool is saved to templates/proxy_list.json (active proxy also mirrored here for startup).
# PROXY_SERVER=
# PROXY_USERNAME=
# PROXY_PASSWORD=
# PROXY_BYPASS=localhost,127.0.0.1

# --- Local web dashboard (http://127.0.0.1:3847) ---
# Starts with headless or headed Playwright — the dashboard is a separate localhost UI.
# Requires KEEP_OPEN=true (or npm run dashboard / --keep-open).
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3847
DASHBOARD_OPEN_BROWSER=true
# Compact UI for web dashboard + terminal menus (Settings [D]). Recommended on Pi 3.5" TFT (480×320).
DASHBOARD_COMPACT_VIEW=false

# --- Timing ---
RANDOM_DELAY_MIN_MS=1000
RANDOM_DELAY_MAX_MS=2000

# --- Session loop (optional) ---
SESSION_LOOP_ENABLED=false
SESSION_PLAY_MIN_MINUTES=60
SESSION_PLAY_MAX_MINUTES=120
SESSION_REST_MIN_MINUTES=5
SESSION_REST_MAX_MINUTES=15
# When session loop logs out to rest then re-login, rotate to the next proxy in the pool (if 2+ saved).
# Status/API expose proxyWillRotateOnRest; wake logs the next egress proxy.
PROXY_ROTATE_ON_SESSION_REST=true
# Restart Chromium after this many hours to limit RAM growth (0 = off). Waits for idle actions first.
BROWSER_REFRESH_HOURS=0
# Minutes before a manual pause (P) auto-resumes. 0 = stay paused until you resume.
MANUAL_PAUSE_AUTO_UNPAUSE_MINUTES=0

# --- 24/7 keep-alive (optional external watchdog; not .env-driven) ---
# Run: npm run start:24-7   (bot + net sampler + keep-alive in tmux)
# Or:  npm run keep-alive   (watchdog only; expects dashboard already running)
# Optional shell env overrides:
#   CHECK_SECONDS=60        # how often keep-alive polls
#   STALE_MINUTES=20        # restart if log.jsonl is this old while loops should be active
#   STALE_GRACE_MINUTES=5   # after a restart, skip stale-log restarts for this long
#   DASH_URL=http://127.0.0.1:3847/api/status
# Heartbeats / restarts: keep-alive.log (gitignored)

# --- Farmlist loop ---
FARMLIST_LOOP_ENABLED=false
FARMLIST_LOOP_MIN_MINUTES=10
FARMLIST_LOOP_MAX_MINUTES=20

# --- Builder ---
BUILDER_LOOP_ENABLED=false
BUILDER_LOOP_MIN_MINUTES=5
BUILDER_LOOP_MAX_MINUTES=10
BUILDER_ROUND_ROBIN_ENABLED=false
BUILDER_RR_EXCLUDED_VILLAGE_IDS=
# Auto builder loop plan: resource (fields) or village (buildings). Manual keys 2/3 override for one step.
BUILDER_DEFAULT_PLAN_MODE=resource
# With builder RR on: after resource fields are complete per village, continue village-stage templates (default true when plan=resource).
BUILDER_RR_RESOURCE_THEN_VILLAGE=true
BUILDER_GOLD_COMPLETE_ENABLED=false
BUILDER_GOLD_COMPLETE_MAX=3
BUILDER_MASTER_BUILDER_ENABLED=false

# --- Status after farmlists ---
STATUS_AFTER_FARMLISTS_ENABLED=true
STATUS_AFTER_FARMLISTS_COOLDOWN_MINUTES=15

# --- Troop trainer (plans) ---
# Master on/off for the troop auto-train loop. Create plans and assign villages in the terminal: main menu T.
# A "plan" = unit + qty for Barracks, Great Barracks, Stable, and/or Great Stable, plus its own timer.
# When a village's timer fires it trains each configured branch (target qty, or max affordable if short on resources).
# Plans and assignments are stored in templates/troop_plans.json.
TROOP_TRAINING_ROUND_ROBIN_ENABLED=false
# Default timer used when a plan does not set its own (minutes).
TROOP_TRAINING_LOOP_MIN_MINUTES=30
TROOP_TRAINING_LOOP_MAX_MINUTES=60

# --- Cranny defense (rr: upgrade/built crannies to L10, then fill free slots) ---
CRANNY_DEFENSE_ROUND_ROBIN_ENABLED=false
CRANNY_DEFENSE_LOOP_MIN_MINUTES=8
CRANNY_DEFENSE_LOOP_MAX_MINUTES=15

# --- Activity simulation (random page browsing, no game actions) ---
ACTIVITY_SIMULATION_ENABLED=false
ACTIVITY_SIMULATION_LOOP_MIN_MINUTES=20
ACTIVITY_SIMULATION_LOOP_MAX_MINUTES=45
# Comma list: status,builder,troops,stable,reports,statistics
ACTIVITY_SIMULATION_PATTERNS=status,builder,troops,stable,reports
ACTIVITY_SIMULATION_DWELL_MIN_MS=2000
ACTIVITY_SIMULATION_DWELL_MAX_MS=6000

# --- Top 10 statistics tracking (primary: your Robbers raid income → resources / hour) ---
# Scrapes statistics.php; dashboard Top 10 tab shows raid-income /h from Robbers polls.
# Active /h excludes long downtime gaps; wall /h uses full elapsed time.
TOP10_TRACKING_ENABLED=false
TOP10_TRACKING_LOOP_MIN_MINUTES=60
TOP10_TRACKING_LOOP_MAX_MINUTES=120
TOP10_TRACKING_LOG_FILE=top10.log
# One JSON object per line (JSONL) per category per snapshot (ts, epochMs, top10, self).
# Dashboard GET /api/top10 → raidIncome (+ standings / category boards).
# Optional in-game player name for self-rank matching (defaults to auto-detect from the session UI).
# TOP10_TRACKING_PLAYER_NAME=

# --- Expansion ---
EXPANSION_AUTO_DISPATCH_ENABLED=false
EXPANSION_USE_PLANNED_TARGETS=false
EXPANSION_PLANNED_TARGETS_FILE=templates/settlement_targets.json

# --- Resource circulation (marketplace sends between your villages) ---
RESOURCE_CIRCULATION_ENABLED=false
RESOURCE_CIRCULATION_EXPANSION_ENABLED=false
RESOURCE_CIRCULATION_RECEIVER_MAX_FILL_RATIO=0.8
RESOURCE_CIRCULATION_MAX_DONORS=3
RESOURCE_CIRCULATION_BUILDER_MAX_DONORS=1
RESOURCE_CIRCULATION_BUILDER_MERCHANT_LOADS=4
RESOURCE_CIRCULATION_RESERVE_PER_RESOURCE=500

# --- Raid evacuation (auto-send surplus above 80% of cranny protection to pivot village) ---
RAID_EVACUATION_ENABLED=false
RAID_EVACUATION_TROOPS_ENABLED=true
RAID_EVACUATION_TROOP_RECALL_SECONDS=60
RAID_EVACUATION_TRIGGER_MINUTES=30
RAID_EVACUATION_RESERVE_PER_RESOURCE=300
RAID_EVACUATION_MERCHANT_CAPACITY_FALLBACK=1000
# Optional CSV ids. If empty, pivot defaults to Capital (or first non-source village).
RAID_EVACUATION_PIVOT_VILLAGE_IDS=
# How often to scan for incoming raids (seconds). Default 30 — was 5s and cycled every village in the browser.
RAID_EVACUATION_POLL_SECONDS=30
# Pause after switching village in the browser (ms). Headed default 800 if unset; headless default 0.
# VILLAGE_SWITCH_DELAY_MS=800

# --- Game URLs / selectors (override only if Nexian markup differs) ---
# Pin farmlist sending to a village that has a Rally Point (defaults to capital).
# Set this if your farmlists fail when the active village has no rally point.
# FARMLIST_VILLAGE_ID=
# FARMLIST_URL=
# VILLAGE_BUILDER_URL=
# VILLAGE_STATUS_URL=
# TROOP_TRAINER_URL=
# TROOP_STABLE_TRAINER_URL=
# LOGOUT_URL=
# FARMLIST_SELECT_ALL_SELECTOR=
# FARMLIST_SEND_BUTTON_SELECTOR=

# --- Logging ---
NEXIAN_ACTION_LOG_FILE=log.jsonl
# When log.jsonl exceeds this size (bytes), it is moved to log-archive/ and a new file starts (default 10MB).
NEXIAN_ACTION_LOG_MAX_BYTES=10485760
# Optional; default is log-archive/ next to the log file.
# NEXIAN_ACTION_LOG_ARCHIVE_DIR=log-archive
